{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": [
			"$app/types",
			"node"
		],
		"baseUrl": ".",
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
